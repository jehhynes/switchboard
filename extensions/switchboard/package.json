{
  "name": "switchboard",
  "displayName": "Switchboard",
  "version": "0.0.0",
  "private": true,
  "publisher": "switchboard",
  "description": "Triages tickets assigned to you into playbooks and runs them in Claude Code sessions.",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "configuration": {
      "title": "Switchboard",
      "properties": {
        "switchboard.configDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Folder holding `settings.json` and `playbooks/`, such as a folder in a git repository. An absolute path or one starting with `~`. Empty uses `~/.switchboard`. A change restarts the hub on the new folder."
        },
        "switchboard.notifyNeedsYou": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a notification in the focused window when a work item starts needing you, such as an approval or a question."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "switchboard",
          "title": "Switchboard",
          "icon": "media/switchboard.svg"
        }
      ]
    },
    "views": {
      "switchboard": [
        {
          "type": "webview",
          "id": "switchboard.workItems",
          "name": "Switchboard"
        }
      ]
    },
    "commands": [
      {
        "command": "switchboard.goTo",
        "title": "Go to Work Item…",
        "category": "Switchboard",
        "icon": "$(search)"
      },
      {
        "command": "switchboard.newAdhoc",
        "title": "New Ad-hoc Session…",
        "category": "Switchboard",
        "icon": "$(add)"
      },
      {
        "command": "switchboard.openSettings",
        "title": "Open Settings",
        "category": "Switchboard",
        "icon": "$(gear)"
      },
      {
        "command": "switchboard.source.github.on",
        "title": "Stop Polling GitHub",
        "category": "Switchboard",
        "icon": {
          "light": "media/sources/github-icon-on-light.svg",
          "dark": "media/sources/github-icon-on-dark.svg"
        }
      },
      {
        "command": "switchboard.source.github.off",
        "title": "Poll GitHub",
        "category": "Switchboard",
        "icon": {
          "light": "media/sources/github-icon-off-light.svg",
          "dark": "media/sources/github-icon-off-dark.svg"
        }
      },
      {
        "command": "switchboard.source.zoho.on",
        "title": "Stop Polling Zoho Desk",
        "category": "Switchboard",
        "icon": {
          "light": "media/sources/zoho-icon-on-light.svg",
          "dark": "media/sources/zoho-icon-on-dark.svg"
        }
      },
      {
        "command": "switchboard.source.zoho.off",
        "title": "Poll Zoho Desk",
        "category": "Switchboard",
        "icon": {
          "light": "media/sources/zoho-icon-off-light.svg",
          "dark": "media/sources/zoho-icon-off-dark.svg"
        }
      },
      {
        "command": "switchboard.source.forum.on",
        "title": "Stop Polling Forum",
        "category": "Switchboard",
        "icon": {
          "light": "media/sources/forum-icon-on-light.svg",
          "dark": "media/sources/forum-icon-on-dark.svg"
        }
      },
      {
        "command": "switchboard.source.forum.off",
        "title": "Poll Forum",
        "category": "Switchboard",
        "icon": {
          "light": "media/sources/forum-icon-off-light.svg",
          "dark": "media/sources/forum-icon-off-dark.svg"
        }
      },
      {
        "command": "switchboard.separator",
        "title": "​",
        "enablement": "false",
        "icon": "media/sources/separator.svg"
      },
      {
        "command": "switchboard.row.start",
        "title": "Start",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.approve",
        "title": "Approve",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.retry",
        "title": "Retry",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.stop",
        "title": "Stop",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.triageAgain",
        "title": "Triage Again",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.markDone",
        "title": "Mark Done",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.snooze",
        "title": "Snooze…",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.restore",
        "title": "Restore",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.changes",
        "title": "Open Changes",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.sourceControl",
        "title": "Show in Source Control",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.row.copy",
        "title": "Copy…",
        "category": "Switchboard"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "switchboard.source.github.on",
          "when": "view == switchboard.workItems && switchboard.source.github == on",
          "group": "navigation@1"
        },
        {
          "command": "switchboard.source.github.off",
          "when": "view == switchboard.workItems && switchboard.source.github == off",
          "group": "navigation@1"
        },
        {
          "command": "switchboard.source.zoho.on",
          "when": "view == switchboard.workItems && switchboard.source.zoho == on",
          "group": "navigation@2"
        },
        {
          "command": "switchboard.source.zoho.off",
          "when": "view == switchboard.workItems && switchboard.source.zoho == off",
          "group": "navigation@2"
        },
        {
          "command": "switchboard.source.forum.on",
          "when": "view == switchboard.workItems && switchboard.source.forum == on",
          "group": "navigation@3"
        },
        {
          "command": "switchboard.source.forum.off",
          "when": "view == switchboard.workItems && switchboard.source.forum == off",
          "group": "navigation@3"
        },
        {
          "command": "switchboard.separator",
          "when": "view == switchboard.workItems",
          "group": "navigation@8"
        },
        {
          "command": "switchboard.goTo",
          "when": "view == switchboard.workItems",
          "group": "navigation@9"
        },
        {
          "command": "switchboard.newAdhoc",
          "when": "view == switchboard.workItems",
          "group": "navigation@10"
        },
        {
          "command": "switchboard.openSettings",
          "when": "view == switchboard.workItems",
          "group": "navigation@11"
        }
      ],
      "commandPalette": [
        {
          "command": "switchboard.source.github.on",
          "when": "switchboard.source.github == on"
        },
        {
          "command": "switchboard.source.github.off",
          "when": "switchboard.source.github == off"
        },
        {
          "command": "switchboard.source.zoho.on",
          "when": "switchboard.source.zoho == on"
        },
        {
          "command": "switchboard.source.zoho.off",
          "when": "switchboard.source.zoho == off"
        },
        {
          "command": "switchboard.source.forum.on",
          "when": "switchboard.source.forum == on"
        },
        {
          "command": "switchboard.source.forum.off",
          "when": "switchboard.source.forum == off"
        },
        {
          "command": "switchboard.separator",
          "when": "false"
        },
        {
          "command": "switchboard.row.start",
          "when": "false"
        },
        {
          "command": "switchboard.row.approve",
          "when": "false"
        },
        {
          "command": "switchboard.row.retry",
          "when": "false"
        },
        {
          "command": "switchboard.row.stop",
          "when": "false"
        },
        {
          "command": "switchboard.row.triageAgain",
          "when": "false"
        },
        {
          "command": "switchboard.row.markDone",
          "when": "false"
        },
        {
          "command": "switchboard.row.snooze",
          "when": "false"
        },
        {
          "command": "switchboard.row.restore",
          "when": "false"
        },
        {
          "command": "switchboard.row.changes",
          "when": "false"
        },
        {
          "command": "switchboard.row.sourceControl",
          "when": "false"
        },
        {
          "command": "switchboard.row.copy",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "switchboard.row.start",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.start",
          "group": "1_run@1"
        },
        {
          "command": "switchboard.row.approve",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.approve",
          "group": "1_run@2"
        },
        {
          "command": "switchboard.row.retry",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.retry",
          "group": "1_run@3"
        },
        {
          "command": "switchboard.row.stop",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.stop",
          "group": "1_run@4"
        },
        {
          "command": "switchboard.row.triageAgain",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.triageAgain",
          "group": "2_status@1"
        },
        {
          "command": "switchboard.row.markDone",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.markDone",
          "group": "2_status@2"
        },
        {
          "command": "switchboard.row.snooze",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.snooze",
          "group": "3_snooze@1"
        },
        {
          "command": "switchboard.row.restore",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.restore",
          "group": "3_snooze@1"
        },
        {
          "command": "switchboard.row.changes",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.changes",
          "group": "4_worktree@1"
        },
        {
          "command": "switchboard.row.sourceControl",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.sourceControl",
          "group": "4_worktree@2"
        },
        {
          "command": "switchboard.row.copy",
          "when": "webviewId == 'switchboard.workItems' && webviewSection == 'row' && switchboard.row.copy",
          "group": "1_run@5"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "test:integration": "node test-integration/run.mjs",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@switchboard/core": "*",
    "@switchboard/hub": "*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.104.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
