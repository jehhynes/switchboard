{
  "name": "switchboard",
  "displayName": "Switchboard",
  "version": "0.0.0",
  "private": true,
  "publisher": "switchboard",
  "description": "Triages tickets assigned to you into playbooks and runs them in Claude Code sessions.",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "switchboard",
          "title": "Switchboard",
          "icon": "media/switchboard.svg"
        }
      ]
    },
    "views": {
      "switchboard": [
        {
          "type": "webview",
          "id": "switchboard.workItems",
          "name": "Work items"
        }
      ]
    },
    "commands": [
      {
        "command": "switchboard.newAdhoc",
        "title": "New Ad-hoc Session…",
        "category": "Switchboard",
        "icon": "$(add)"
      },
      {
        "command": "switchboard.chooseSources",
        "title": "Choose Sources…",
        "category": "Switchboard",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "switchboard.newAdhoc",
          "when": "view == switchboard.workItems",
          "group": "switchboard@1"
        },
        {
          "command": "switchboard.chooseSources",
          "when": "view == switchboard.workItems",
          "group": "switchboard@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "test:integration": "node test-integration/run.mjs",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@switchboard/core": "*",
    "@switchboard/hub": "*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.104.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
