{
  "name": "switchboard",
  "displayName": "Switchboard",
  "version": "0.0.0",
  "private": true,
  "publisher": "switchboard",
  "icon": "assets/icon.png",
  "description": "Opens Switchboard's sessions and changes in each work item's VS Code window, and starts the hub and the dock.",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onWebviewPanel:switchboard.history"
  ],
  "contributes": {
    "icons": {
      "switchboard-logo": {
        "description": "Switchboard patch panel",
        "default": {
          "fontPath": "assets/switchboard.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "configuration": {
      "title": "Switchboard",
      "properties": {
        "switchboard.configDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Folder holding `settings.json` and `playbooks/`, such as a folder in a git repository. An absolute path or one starting with `~`. Empty uses `~/.switchboard`. A change restarts the hub on the new folder."
        },
        "switchboard.notifyNeedsYou": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a notification in the focused window when a work item starts needing you, such as an approval or a question."
        }
      }
    },
    "commands": [
      {
        "command": "switchboard.showDock",
        "title": "Show the Dock",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.newClaudeTab",
        "title": "New Claude Session in Editor Tab",
        "category": "Switchboard",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "switchboard.newClaudeTab",
          "when": "!config.claudeCode.useTerminal",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "switchboard.newClaudeTab",
          "when": "view == claudeVSCodeSidebar || view == claudeVSCodeSidebarSecondary",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "test:integration": "node test-integration/run.mjs",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@switchboard/core": "*",
    "@switchboard/hub": "*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.104.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
