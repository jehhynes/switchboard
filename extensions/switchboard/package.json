{
  "name": "switchboard",
  "displayName": "Switchboard",
  "version": "0.0.0",
  "private": true,
  "publisher": "switchboard",
  "icon": "assets/icon.png",
  "description": "Opens Switchboard's sessions and changes in each work item's VS Code window, and starts the hub and the dock.",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onWebviewPanel:switchboard.history"
  ],
  "contributes": {
    "icons": {
      "switchboard-logo": {
        "description": "Switchboard patch panel",
        "default": {
          "fontPath": "assets/switchboard.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "configuration": {
      "title": "Switchboard",
      "properties": {
        "switchboard.configDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Folder holding `settings.json`, with the settings and playbooks, such as a folder in a git repository. An absolute path or one starting with `~`. Empty uses `~/.switchboard`. A change restarts the hub on the new folder."
        },
        "switchboard.closeDoneWindows": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Close an item window once all its work items are done, their sessions have ended their turns and it has not been focused for `#switchboard.closeDoneWindowsAfterMinutes#`, unless it has unsaved changes."
        },
        "switchboard.closeDoneWindowsAfterMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "Minutes a done item window waits, unfocused, before `#switchboard.closeDoneWindows#` closes it."
        },
        "switchboard.sideBarWidthsMinWindow": {
          "type": "number",
          "default": 1200,
          "minimum": 0,
          "markdownDescription": "Window width, in pixels at zoom level 0, under which `#switchboard.rememberSideBarWidths#` does nothing: it keeps no width and sets no side bar until the window is wider again, and then sets each side bar to its kept width."
        },
        "switchboard.rememberSideBarWidths": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep the width you drag each side bar to at each window width, and set each side bar after the window's width changed, to within 30 pixels: between two widths you dragged at, the line between them; outside them, the nearest one scaled by the square root of the window's width. Widths are read from the Switchboard pane, so they are kept and set while it is visible in the Explorer or Source Control. Setting the secondary side bar hides the primary for a moment. **Switchboard: Forget Side Bar Widths** drops the kept widths."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "switchboard.pane",
          "name": "Switchboard"
        }
      ],
      "scm": [
        {
          "type": "webview",
          "id": "switchboard.paneScm",
          "name": "Switchboard"
        }
      ],
      "switchboard-conversation": [
        {
          "type": "webview",
          "id": "switchboard.conversation",
          "name": "Conversation",
          "when": "!switchboard.noSecondarySidebar"
        },
        {
          "id": "switchboard.artifacts",
          "name": "Artifacts",
          "when": "!switchboard.noSecondarySidebar"
        }
      ],
      "switchboard-conversation-activity": [
        {
          "type": "webview",
          "id": "switchboard.conversationActivity",
          "name": "Conversation",
          "when": "switchboard.noSecondarySidebar"
        },
        {
          "id": "switchboard.artifactsActivity",
          "name": "Artifacts",
          "when": "switchboard.noSecondarySidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "switchboard.showDock",
        "title": "Show the Dock",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.showHubLog",
        "title": "Show Hub Log",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.newClaudeTab",
        "title": "New Claude Session in Editor Tab",
        "category": "Switchboard",
        "icon": "$(add)"
      },
      {
        "command": "switchboard.forgetSideBarWidths",
        "title": "Forget Side Bar Widths",
        "category": "Switchboard"
      },
      {
        "command": "switchboard.continueInBackground",
        "title": "Continue in Background",
        "category": "Switchboard",
        "icon": "$(debug-step-out)"
      },
      {
        "command": "switchboard.continueSidebarInBackground",
        "title": "Continue in Background",
        "category": "Switchboard",
        "icon": "$(debug-step-out)"
      },
      {
        "command": "switchboard.openArtifact",
        "title": "Open Artifact",
        "category": "Switchboard"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "switchboard.newClaudeTab",
          "when": "!config.claudeCode.useTerminal",
          "group": "navigation"
        },
        {
          "command": "switchboard.continueInBackground",
          "when": "activeWebviewPanelId == 'claudeVSCodePanel'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "switchboard.continueInBackground",
          "when": "activeWebviewPanelId == 'claudeVSCodePanel'"
        },
        {
          "command": "switchboard.continueSidebarInBackground",
          "when": "false"
        },
        {
          "command": "switchboard.openArtifact",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "switchboard.newClaudeTab",
          "when": "view == claudeVSCodeSidebar || view == claudeVSCodeSidebarSecondary",
          "group": "navigation"
        },
        {
          "command": "switchboard.continueSidebarInBackground",
          "when": "view == claudeVSCodeSidebar || view == claudeVSCodeSidebarSecondary",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "switchboard-conversation",
          "title": "Switchboard",
          "icon": "media/switchboard-dark.svg",
          "when": "!switchboard.noSecondarySidebar"
        }
      ],
      "activitybar": [
        {
          "id": "switchboard-conversation-activity",
          "title": "Switchboard",
          "icon": "media/switchboard-dark.svg",
          "when": "switchboard.noSecondarySidebar"
        }
      ]
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/mermaid/mermaid.min.js",
      "./dist/mermaidPreview.js"
    ],
    "markdown.previewStyles": [
      "./dist/mermaidPreview.css"
    ],
    "viewsWelcome": [
      {
        "view": "switchboard.artifacts",
        "contents": "The session's artifacts show here as it writes them: plans, reports, comparisons, diagrams, pages and media."
      },
      {
        "view": "switchboard.artifactsActivity",
        "contents": "The session's artifacts show here as it writes them: plans, reports, comparisons, diagrams, pages and media."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "test:integration": "node test-integration/run.mjs",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@switchboard/core": "*",
    "@switchboard/holder": "*",
    "@switchboard/hub": "*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.104.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.3.3",
    "mocha": "^12.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "mermaid": "^12.3.0"
  }
}
