{
  "manifest_version": 3,
  "name": "Switchboard",
  "version": "0.0.1",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "description": "Shows Switchboard's playbooks on GitHub project boards, hides and snoozes cards, and groups the links the Switchboard dock opens.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["codicon.ttf"], "matches": ["https://github.com/*"] }],
  "permissions": ["storage", "tabs", "tabGroups", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:47615/*"]
}
