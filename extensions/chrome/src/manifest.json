{
  "manifest_version": 3,
  "name": "Switchboard",
  "version": "0.0.1",
  "key": "",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "description": "Shows Switchboard's playbooks on GitHub project boards, hides and snoozes cards, hides the sidebar and widens issue and pull request pages, and in Chrome keeps embedded web tabs and the web page's external links in a Switchboard tab group.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["layoutStart.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["codicon.ttf"], "matches": ["https://github.com/*"] }],
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*"] },
  "permissions": ["downloads", "storage", "tabs", "tabGroups", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
