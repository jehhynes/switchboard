{
  "name": "@switchboard/voice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The voice process: speech out through OpenAI realtime speech and decibri playback, and the voice target. Holds no conversation, session or work item state; the main entry imports no native module.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@switchboard/core": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "decibri": "5.8.0"
  }
}
