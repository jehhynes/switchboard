{
  "name": "@switchboard/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The web page the hub serves (architecture.md § Web page): its own front end for the conversation API, drawn with copies of VS Code's Dark Modern and Light Modern themes, following the operating system's setting. Its build carries the page's files as strings, which the hub serves.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "check:console": "node check-console.mjs",
    "check:shell": "node check-shell.mjs",
    "check:offline": "node check-offline.mjs"
  },
  "devDependencies": {
    "@pierre/diffs": "1.6.4",
    "@shikijs/langs": "4.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.3.3",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "preact": "^11.2.0",
    "qrcode-generator": "^2.0.4",
    "shiki": "4.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@switchboard/conversation": "*",
    "@switchboard/core": "*",
    "@switchboard/protocol": "*"
  }
}
