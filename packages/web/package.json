{
  "name": "@switchboard/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The web page the hub serves (architecture.md § Web page): its own front end for the conversation API, drawn with a copy of VS Code's Dark Modern theme. Its build carries the page's files as strings, which the hub serves.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/codicons": "^0.0.46-24",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.3.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@switchboard/conversation": "*",
    "@switchboard/core": "*"
  }
}
