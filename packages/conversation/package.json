{
  "name": "@switchboard/conversation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The conversation layer: reads a Code Mode session's replies and messages from its transcript, with the screen as an early copy. Runs in the hub; imports no native module and must not import vscode. `./questions`, `./providerIcons`, `./voiceControls`, `./messageMeta`, `./spokenBubble`, `./menuPlace`, `./contextMeter` and `./questionCard` import nothing, for browser bundles, and `./bubbles.css` and `./questionCard.css` are styles both front ends share.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./questions": {
      "types": "./dist/questions.d.ts",
      "default": "./dist/questions.js"
    },
    "./providerIcons": {
      "types": "./dist/providerIcons.d.ts",
      "default": "./dist/providerIcons.js"
    },
    "./voiceControls": {
      "types": "./dist/voiceControls.d.ts",
      "default": "./dist/voiceControls.js"
    },
    "./messageMeta": {
      "types": "./dist/messageMeta.d.ts",
      "default": "./dist/messageMeta.js"
    },
    "./contextMeter": {
      "types": "./dist/contextMeter.d.ts",
      "default": "./dist/contextMeter.js"
    },
    "./spokenBubble": {
      "types": "./dist/spokenBubble.d.ts",
      "default": "./dist/spokenBubble.js"
    },
    "./questionCard": {
      "types": "./dist/questionCard.d.ts",
      "default": "./dist/questionCard.js"
    },
    "./menuPlace": {
      "types": "./dist/menuPlace.d.ts",
      "default": "./dist/menuPlace.js"
    },
    "./bubbles.css": "./src/bubbles.css",
    "./composer.css": "./src/composer.css",
    "./picker.css": "./src/picker.css",
    "./menu.css": "./src/menu.css",
    "./questionCard.css": "./src/questionCard.css"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@switchboard/core": "*",
    "@xterm/headless": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
