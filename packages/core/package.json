{
  "name": "@switchboard/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domain types, paths and contracts shared by the hub and the extension. Must not import vscode.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./group": {
      "types": "./dist/group.d.ts",
      "default": "./dist/group.js"
    },
    "./snooze": {
      "types": "./dist/snooze.d.ts",
      "default": "./dist/snooze.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./limit": {
      "types": "./dist/limit.d.ts",
      "default": "./dist/limit.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
