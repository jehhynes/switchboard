<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Switchboard.Dock.Views"
        xmlns:hub="using:Switchboard.Dock.Hub"
        xmlns:platform="using:Switchboard.Dock.Platform"
        x:Class="Switchboard.Dock.Views.MainWindow"
        x:DataType="views:DockViewModel"
        Title="Switchboard"
        Icon="avares://Switchboard.Dock/Assets/dock.ico"
        Width="320" Height="800"
        Background="{DynamicResource DockBackground}"
        Foreground="{DynamicResource DockForeground}"
        FontFamily="Segoe UI" FontSize="13"
        WindowDecorations="None" CanResize="False" ShowInTaskbar="False" Topmost="True">
  <Window.Styles>
    <!-- Done draws only its rows in view, so a search that opens it with hundreds of rows draws a screenful (PRD R63). Other groups draw every row,
         which dragging in Ready for review measures. -->
    <Style Selector="ItemsControl.band-rows.done">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource DockMuted}" />
    </Style>
    <!-- An empty group's message starts where a row's text does (3px stripe, 8px padding); italic, not faded, so it keeps the muted colour's contrast. -->
    <Style Selector="TextBlock.empty-state">
      <Setter Property="Foreground" Value="{DynamicResource DockMuted}" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Margin" Value="11,8,8,8" />
    </Style>
    <!-- Codicon glyphs fill their em box above the baseline, while Segoe UI's capitals sit low in a taller line box, so centred icons sit about
         1px above the text's middle; 2px of top padding moves a centred icon down 1px. -->
    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="{StaticResource Codicons}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,2,0,0" />
    </Style>
    <!-- Header and toast icons are centred in their buttons, without the 1px offset that lines icons up with text. -->
    <Style Selector="Button.header, Button.dismiss">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.header TextBlock.icon, Button.dismiss TextBlock.icon">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.header:pointerover /template/ ContentPresenter, Button.dismiss:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DockHover}" />
    </Style>
    <Style Selector="Border.separator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background" Value="{DynamicResource DockMuted}" />
      <Setter Property="Opacity" Value="0.3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Each logo fits 16px and is centred; the wide Forum logo may be 24px wide, so it is not drawn smaller than the others. -->
    <!-- The list's scroll bar shows only while the pointer is over the list. -->
    <Style Selector="ScrollViewer#RowScroller /template/ ScrollBar">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ScrollViewer#RowScroller:pointerover /template/ ScrollBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Path.source">
      <Setter Property="MaxWidth" Value="16" />
      <Setter Property="MaxHeight" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.source.github">
      <Setter Property="Fill" Value="{DynamicResource DockSourceGithub}" />
    </Style>
    <Style Selector="Path.source.forum">
      <Setter Property="MaxWidth" Value="24" />
      <Setter Property="Fill" Value="{DynamicResource DockKeyForum}" />
    </Style>
    <Style Selector="Path.source.zoho">
      <Setter Property="Stroke" Value="{DynamicResource DockKeyZoho}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <!-- A source that is not polled shows its logo in grey. -->
    <Style Selector="Path.source.off">
      <Setter Property="Fill" Value="{DynamicResource DockSourceOff}" />
    </Style>
    <Style Selector="Path.source.zoho.off">
      <Setter Property="Fill" Value="{x:Null}" />
      <Setter Property="Stroke" Value="{DynamicResource DockSourceOff}" />
    </Style>
    <!-- A row's buttons are VS Code-sized, 26px tall with a 16px icon, as the VS Code panel's were: Approve in the button colour, the others
         in a light tint of the text colour. -->
    <Style Selector="Button.main, Button.icon-button">
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.main">
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Padding" Value="5,0" />
    </Style>
    <Style Selector="Button.main TextBlock.icon, Button.icon-button TextBlock.icon">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.main:not(.accent), Button.icon-button">
      <Setter Property="Background" Value="{DynamicResource DockActionButton}" />
    </Style>
    <Style Selector="Button.main:not(.accent):pointerover /template/ ContentPresenter, Button.icon-button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DockActionButtonHover}" />
    </Style>
    <!-- The row's buttons show only while it is selected (PRD R27). -->
    <Style Selector="Border.row StackPanel.actions">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.row.selected StackPanel.actions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- After the selected style, so a row with no buttons does not give their margin's width away from lines 2 and 3. -->
    <Style Selector="Border.row StackPanel.actions.empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Group headings are a tinted bar of the focus blue, as in the VS Code panel. -->
    <Style Selector="Border.group">
      <Setter Property="Background" Value="{DynamicResource DockGroupBar}" />
      <Setter Property="Padding" Value="6,5,8,5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.group:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockGroupBarHover}" />
    </Style>
    <Style Selector="TextBlock.group-icon">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <!-- Done's date bands are a muted label and a rule, with no tint or left edge, so they do not look like a row's status stripe. -->
    <Style Selector="Border.band">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.band:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockHover}" />
    </Style>
    <Style Selector="Border.band TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DockMuted}" />
    </Style>
    <Style Selector="Border.band-rule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Background" Value="{DynamicResource DockMuted}" />
      <Setter Property="Opacity" Value="0.3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A rule across the top of each row after the first in its band. -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DockBorder}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ContentPresenter:nth-child(1) > Border.row">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockHover}" />
    </Style>
    <Style Selector="Border.row.selected">
      <Setter Property="Background" Value="{DynamicResource DockSelected}" />
    </Style>
    <!-- Inset top and bottom so adjacent rows' stripes stay separate. -->
    <Style Selector="Border.stripe">
      <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style Selector="Border.row.selected Border.stripe">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Border.stripe.warning">
      <Setter Property="Background" Value="{DynamicResource DockStripeWarning}" />
    </Style>
    <Style Selector="Border.stripe.error">
      <Setter Property="Background" Value="{DynamicResource DockStripeError}" />
    </Style>
    <Style Selector="Border.stripe.turn">
      <Setter Property="Background" Value="{DynamicResource DockStripeTurn}" />
    </Style>
    <!-- A Ready for review row on the agent's turn dims its texts; the selection keeps full strength. -->
    <Style Selector="Border.row.dim Grid.content">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <!-- Where a dragged Ready for review row will drop. -->
    <Style Selector="Border#DropLine">
      <Setter Property="Height" Value="2" />
      <Setter Property="Background" Value="{DynamicResource DockTurn}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl#GroupList:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TextBlock.failed">
      <Setter Property="Foreground" Value="{DynamicResource DockError}" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource DockWarning}" />
    </Style>
    <!-- The status toast is neutral for a message that reports no problem, and takes the warning colours only for a problem. -->
    <Style Selector="Border.toast">
      <Setter Property="Margin" Value="8" />
      <Setter Property="Padding" Value="8,4,4,4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DockMuted}" />
      <Setter Property="Background" Value="{DynamicResource DockHover}" />
    </Style>
    <Style Selector="Border.toast.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource DockWarning}" />
      <Setter Property="Background" Value="{DynamicResource DockWarningFill}" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="Foreground" Value="{DynamicResource DockMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <!-- Between details, as the hub's " · " within one, so a wake time and a comment do not run together. -->
    <Style Selector="TextBlock.detail-separator">
      <Setter Property="Foreground" Value="{DynamicResource DockMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="TextBlock.detail.warning">
      <Setter Property="Foreground" Value="{DynamicResource DockWarning}" />
    </Style>
    <Style Selector="TextBlock.detail.error">
      <Setter Property="Foreground" Value="{DynamicResource DockError}" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource DockCountBadge}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource DockCountBadgeForeground}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- After Border.badge, so an empty group's muted badge wins. -->
    <Style Selector="Border.badge.zero">
      <Setter Property="Background" Value="{DynamicResource DockBadgeZero}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource DockMuted}" />
    </Style>
    <!-- Ticket keys, link badges and Returned are outlined pills with a muted fill, in the source's or a pull request's colour as in the VS Code
         panel; a pill with a link opens it. -->
    <Style Selector="Border.pill">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DockMuted}" />
      <Setter Property="Background" Value="{DynamicResource DockPillFill}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Height" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="TextElement.FontSize" Value="12" />
    </Style>
    <Style Selector="Border.pill > TextBlock, Border.pill StackPanel > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.pill-icon">
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- A compact pill shows only its icon, with its text in its tooltip; a pill shows an icon it has only for that, such as the ticket's source
         logo, only while compact. -->
    <Style Selector="Border.pill.compact TextBlock.pill-text">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.pill:not(.compact) :is(Control).compact-only">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.pill.absent, Border.pill.overflow">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Path.pill-logo">
      <Setter Property="MaxWidth" Value="12" />
      <Setter Property="MaxHeight" Value="12" />
    </Style>
    <Style Selector="Border.pill:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockPillFillHover}" />
    </Style>
    <Style Selector="Border.pill.github">
      <Setter Property="BorderBrush" Value="{DynamicResource DockKeyGithub}" />
      <Setter Property="Background" Value="{DynamicResource DockKeyGithubFill}" />
    </Style>
    <Style Selector="Border.pill.github:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockKeyGithubHover}" />
    </Style>
    <Style Selector="Border.pill.zoho">
      <Setter Property="BorderBrush" Value="{DynamicResource DockKeyZoho}" />
      <Setter Property="Background" Value="{DynamicResource DockKeyZohoFill}" />
    </Style>
    <Style Selector="Border.pill.zoho:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockKeyZohoHover}" />
    </Style>
    <Style Selector="Border.pill.forum">
      <Setter Property="BorderBrush" Value="{DynamicResource DockKeyForum}" />
      <Setter Property="Background" Value="{DynamicResource DockKeyForumFill}" />
    </Style>
    <Style Selector="Border.pill.forum:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockKeyForumHover}" />
    </Style>
    <Style Selector="Border.pill.pr">
      <Setter Property="BorderBrush" Value="{DynamicResource DockPullRequest}" />
      <Setter Property="Background" Value="{DynamicResource DockPullRequestFill}" />
    </Style>
    <Style Selector="Border.pill.pr:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockPullRequestHover}" />
    </Style>
    <!-- After the colour styles: a link the ticket's text names is not the work's own, so it is grey (PRD R61). -->
    <Style Selector="Border.pill.mentioned">
      <Setter Property="BorderBrush" Value="{DynamicResource DockMuted}" />
      <Setter Property="Background" Value="{DynamicResource DockPillFill}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource DockMuted}" />
    </Style>
    <Style Selector="Border.pill.mentioned:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockPillFillHover}" />
    </Style>
    <!-- Returned asks for attention, so it takes the warning stripe's colour, its text the warning text colour, and opens nothing. -->
    <Style Selector="Border.pill.returned">
      <Setter Property="BorderBrush" Value="{DynamicResource DockStripeWarning}" />
      <Setter Property="Background" Value="{DynamicResource DockStripeWarningFill}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource DockWarning}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!-- Rows, group and band headings and link pills take the keyboard focus; a keyboard focus shows as a ring in the focus blue. After the row
         rules, so it wins over the first row's missing rule. -->
    <Style Selector="Border.row:focus-visible, Border.group:focus-visible, Border.band:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource DockFocus}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ContentPresenter:nth-child(1) &gt; Border.row:focus-visible">
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.pill:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource DockFocus}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.spin">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Style.Animations>
        <Animation Duration="0:0:1.5" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="Auto,*,Auto">
    <!-- The inner edge of a dock on the right: dragging it sets the dock's width. -->
    <Border Name="GripLeft" Width="5" Background="Transparent" Cursor="SizeWestEast" BorderBrush="{DynamicResource DockBorder}" BorderThickness="0,0,1,0"
            IsVisible="{Binding GripOnLeft}" PointerPressed="OnGripPressed" PointerMoved="OnGripMoved" PointerReleased="OnGripReleased" PointerCaptureLost="OnGripCaptureLost" />
    <DockPanel Name="ListPanel" Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Margin="8,0,0,0" Spacing="4">
        <!-- 35px, the height of VS Code's title bar on Windows. Close and the header's buttons keep their width on a narrow dock and the title takes
             what is left, ending in an ellipsis (HeaderPanel). -->
        <views:HeaderPanel Height="35">
          <!-- Dragging the title docks the dock at the nearer left or right edge of the monitor under the pointer as it moves. -->
          <TextBlock Name="MoveHandle" Text="Switchboard" FontSize="12" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Cursor="SizeAll" Background="Transparent"
                     ToolTip.Tip="Drag to the left or right half of a monitor to dock there" PointerPressed="OnMovePressed" PointerMoved="OnMoveMoved" PointerReleased="OnMoveReleased" PointerCaptureLost="OnMoveCaptureLost" />
          <ItemsControl Name="SourceList" ItemsSource="{Binding Sources}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:SourceViewModel">
                <Button Classes="header" Click="OnSourceClicked" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Name}">
                  <Panel MinWidth="16" Height="16">
                    <Path Classes="source github" Classes.off="{Binding !Enabled}" IsVisible="{Binding IsGithub}" Data="{StaticResource SourceGithub}" />
                    <Path Classes="source zoho" Classes.off="{Binding !Enabled}" IsVisible="{Binding IsZoho}" Data="{StaticResource SourceZoho}" />
                    <Path Classes="source forum" Classes.off="{Binding !Enabled}" IsVisible="{Binding IsForum}" Data="{StaticResource SourceForum}" />
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="separator" IsVisible="{Binding !!Sources.Count}" />
          <Button Name="SearchButton" Classes="header" Click="OnSearchClicked" ToolTip.Tip="Search" AutomationProperties.Name="Search">
            <TextBlock Classes="icon" Text="&#xEA6D;" />
          </Button>
          <Button Name="AutoHideButton" Classes="header" Click="OnAutoHideClicked" ToolTip.Tip="{Binding AutoHideTip}" AutomationProperties.Name="Auto-hide">
            <TextBlock Classes="icon" Text="{Binding AutoHideGlyph}" />
          </Button>
          <!-- New ad-hoc session and conversation, Held sessions, Refresh sources and Show hub log, and Open Settings, in a menu to keep the title row short. -->
          <Button Name="MoreButton" Classes="header" Click="OnMoreClicked" ToolTip.Tip="More Actions…" AutomationProperties.Name="More Actions">
            <TextBlock Classes="icon" Text="&#xEA7C;" />
          </Button>
          <!-- Set apart, so Close is not clicked by mistake for another control. -->
          <Border Classes="separator" Margin="8,0" />
          <Button Name="CloseButton" Classes="header" Click="OnCloseClicked" ToolTip.Tip="Close the dock" AutomationProperties.Name="Close the dock">
            <TextBlock Classes="icon" Text="&#xEA76;" />
          </Button>
        </views:HeaderPanel>
        <TextBox Name="SearchBox" Text="{Binding Query}" IsVisible="{Binding SearchOpen}" PlaceholderText="Search title, key, PR, playbook, branch" KeyDown="OnSearchKey" Margin="0,0,8,8" FontSize="13">
          <TextBox.InnerRightContent>
            <Button Name="ClearSearchButton" Classes="header" Click="OnClearSearchClicked" ToolTip.Tip="Clear search" AutomationProperties.Name="Clear search">
              <TextBlock Classes="icon" Text="&#xEA76;" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>
        <!-- The searched time range (PRD R63), always shown with the search box. -->
        <Button Name="SearchRangeButton" Classes="link" IsVisible="{Binding SearchOpen}" Click="OnSearchRangeClicked" Margin="8,0,8,8" HorizontalAlignment="Left"
                ToolTip.Tip="Choose how far back to search" AutomationProperties.Name="{Binding RangeText, StringFormat='Search range: {0}'}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" />
            <TextBlock Classes="icon" Text="&#xEAB4;" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <Border Name="StatusToast" DockPanel.Dock="Bottom" Classes="toast" Classes.warning="{Binding StatusIsProblem}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="StatusLine" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Classes.warning="{Binding StatusIsProblem}" Tapped="OnStatusTapped" />
          <Button Name="DismissStatusButton" Grid.Column="1" Classes="dismiss" VerticalAlignment="Top" Click="OnDismissStatusClicked"
                  ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
            <TextBlock Classes="icon" Text="&#xEA76;" />
          </Button>
        </Grid>
      </Border>
      <ScrollViewer Name="RowScroller" HorizontalScrollBarVisibility="Disabled">
        <Panel>
        <StackPanel Name="ListContent">
          <TextBlock Name="ConnectionLine" Text="{Binding Connection}" IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.IsNotNull}}"
                     TextWrapping="Wrap" Margin="8,6" Classes="muted" />
          <Button Name="StartHubButton" Content="Start hub" IsVisible="{Binding CanStartHub}" Click="OnStartHubClicked" HorizontalAlignment="Left" Margin="8,0,8,6" />
          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8,4" Classes="warning" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Held sessions without a work item (PRD R94); a click opens the held sessions window. -->
          <Button Name="HeldNoteButton" Click="OnHeldNoteClicked" IsVisible="{Binding HeldNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  ToolTip.Tip="Open held sessions" AutomationProperties.Name="Open held sessions">
            <TextBlock Text="{Binding HeldNote}" TextWrapping="Wrap" Classes="warning" />
          </Button>
          <!-- Why no device has the voice when the phone was lost (PRD R119): information, so untoned. -->
          <TextBlock Name="VoiceNoteLine" Text="{Binding VoiceNote}" IsVisible="{Binding VoiceNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                     TextWrapping="Wrap" Margin="8,4" Classes="muted" />
          <!-- A terminal holder from an older build, or restarting (architecture.md § Restarting the holder). -->
          <StackPanel Name="HolderNotice" IsVisible="{Binding HolderNoticeText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="8,4">
            <TextBlock Name="HolderNoticeLine" Text="{Binding HolderNoticeText}" TextWrapping="Wrap" Classes="warning" />
            <Button Name="HolderRestartButton" Content="Restart and resume" IsVisible="{Binding CanRestartHolder}" Click="OnHolderRestartClicked"
                    HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
          <Grid Name="HolderResult" ColumnDefinitions="*,Auto" IsVisible="{Binding HolderResultText, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="8,4">
            <TextBlock Name="HolderResultLine" Text="{Binding HolderResultText}" TextWrapping="Wrap" VerticalAlignment="Center" Classes.warning="{Binding HolderResultFailed}" />
            <Button Name="DismissHolderResultButton" Grid.Column="1" Classes="dismiss" VerticalAlignment="Top" Click="OnDismissHolderResultClicked"
                    ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
              <TextBlock Classes="icon" Text="&#xEA76;" />
            </Button>
          </Grid>
          <!-- Without the hub the last rows stay for reference, dimmed, and their controls do nothing. -->
          <ItemsControl Name="GroupList" ItemsSource="{Binding Groups}" IsEnabled="{Binding IsLive}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:GroupViewModel">
                <StackPanel IsVisible="{Binding IsShown}" Margin="0,0,0,8">
                  <!-- Pinned to the top of the list while the group's rows scroll under it, until the next heading pushes it up (PinGroupHeads);
                       on the dock's background, so the tinted bar is opaque and rows do not show through it. -->
                  <Border Classes="group-pin" Background="{DynamicResource DockBackground}" ZIndex="1">
                    <Border Classes="group" Focusable="True" PointerPressed="OnHeaderPressed" Tapped="OnGroupTapped" DoubleTapped="OnGroupTapped">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Classes="icon" Text="{Binding Chevron}" Margin="0,0,4,0" />
                        <TextBlock Grid.Column="1" Classes="icon group-icon" Text="{Binding Glyph}" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="3" Classes="badge" Classes.zero="{Binding IsZero}">
                          <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Border>
                  </Border>
                  <StackPanel IsVisible="{Binding ShowsRows}">
                    <TextBlock Text="{Binding Empty}" IsVisible="{Binding ShowEmpty}" Classes="empty-state" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Bands}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:BandViewModel">
                          <StackPanel>
                            <!-- Done's date bands (PRD R27); other groups have one band with no heading. -->
                            <Border Classes="band" Focusable="True" IsVisible="{Binding HasTitle}" PointerPressed="OnHeaderPressed" Tapped="OnBandTapped" DoubleTapped="OnBandTapped">
                              <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                <TextBlock Classes="icon" Text="{Binding Chevron}" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="3" Classes="band-rule" />
                              </Grid>
                            </Border>
                    <ItemsControl Classes="band-rows" Classes.done="{Binding InDone}" ItemsSource="{Binding Shown}" IsVisible="{Binding ShowsRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:RowViewModel">
                          <Border Classes="row" Focusable="True" Classes.selected="{Binding IsSelected}" Classes.dim="{Binding IsDim}" Tapped="OnRowTapped" ContextRequested="OnRowContext" GotFocus="OnRowGotFocus">
                            <Grid ColumnDefinitions="3,*">
                              <Border Classes="stripe" Classes.warning="{Binding StripeWarning}" Classes.error="{Binding StripeError}" Classes.turn="{Binding StripeTurn}" />
                              <!-- The row's buttons sit beside lines 2 and 3, so they never shorten the title or hide the time. -->
                              <Grid Grid.Column="1" Classes="content" Margin="8,5,8,6" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                  <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource DockPriority}"
                                           IsVisible="{Binding IsPriority}" ToolTip.Tip="{Binding PriorityTitle}" />
                                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                  <!-- The mic mark of the row the voice speaks for (architecture.md § Voice). -->
                                  <TextBlock Name="VoiceMark" Grid.Column="2" Classes="icon" Text="{Binding VoiceGlyph}" IsVisible="{Binding HasVoice}" ToolTip.Tip="{Binding VoiceTitle}"
                                             AutomationProperties.Name="{Binding VoiceTitle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="4" Text="{Binding Time}" ToolTip.Tip="{Binding TimeTitle}" Classes="muted" Margin="8,0,0,0" />
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,3,0,0" Spacing="3">
                                <!-- Line 2's pills shrink to their icon rather than being cut, longest first and Returned last (PillLine). -->
                                <views:PillLine Spacing="6" ClipToBounds="True">
                                  <TextBlock Name="CommentIcon" Classes="icon muted" Text="{Binding CommentGlyph}" IsVisible="{Binding HasComment}" ToolTip.Tip="{Binding CommentTitle}" VerticalAlignment="Center" />
                                  <TextBlock Classes="fill" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Row.Playbook}">
                                    <Run Text="{Binding Namespace}" Foreground="{DynamicResource DockMuted}" /><Run Text="{Binding Name}" />
                                  </TextBlock>
                                  <Border Classes="pill" Classes.github="{Binding IsGithub}" Classes.zoho="{Binding IsZoho}" Classes.forum="{Binding IsForum}"
                                          Tag="{Binding Url}" ToolTip.Tip="{Binding TicketTip}" Tapped="OnPillTapped" Focusable="True"
                                          AutomationProperties.Name="{Binding Ticket}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                      <Panel Classes="compact-only" Width="12" Height="12" VerticalAlignment="Center">
                                        <Path Classes="source github pill-logo" IsVisible="{Binding IsGithub}" Data="{StaticResource SourceGithub}" />
                                        <Path Classes="source zoho pill-logo" IsVisible="{Binding IsZoho}" Data="{StaticResource SourceZoho}" />
                                        <Path Classes="source forum pill-logo" IsVisible="{Binding IsForum}" Data="{StaticResource SourceForum}" />
                                        <TextBlock Classes="icon pill-icon" Text="&#xEA66;" IsVisible="{Binding !HasSourceLogo}" FontSize="12" />
                                      </Panel>
                                      <TextBlock Classes="pill-text" Text="{Binding Ticket}" />
                                    </StackPanel>
                                  </Border>
                                  <ItemsControl ItemsSource="{Binding Links}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="hub:DockLink">
                                        <Border Classes="pill" Classes.pr="{Binding IsPullRequest}" Classes.github="{Binding IsIssue}" Classes.mentioned="{Binding Mentioned}" Tag="{Binding Url}"
                                                ToolTip.Tip="{Binding Tooltip}" Tapped="OnPillTapped" Focusable="True" AutomationProperties.Name="{Binding Label}">
                                          <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock Classes="icon pill-icon" Classes.compact-only="{Binding !HasGlyph}" Text="{Binding IconGlyph}" />
                                            <TextBlock Classes="pill-text" Text="{Binding Text}" />
                                          </StackPanel>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <Border Classes="pill returned" Classes.absent="{Binding !HasReturned}" Focusable="True" ToolTip.Tip="{Binding ReturnedTitle}" AutomationProperties.Name="{Binding ReturnedTitle}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                      <TextBlock Classes="icon pill-icon" Text="&#xEAE2;" />
                                      <TextBlock Classes="pill-text" Text="{Binding ReturnedText}" />
                                    </StackPanel>
                                  </Border>
                                </views:PillLine>
                                <!-- The last detail takes the remaining width and ends in an ellipsis. -->
                                <DockPanel IsVisible="{Binding HasThirdLine}" ClipToBounds="True">
                                  <TextBlock DockPanel.Dock="Left" Classes="icon" Classes.failed="{Binding MarkFailed}" Classes.spin="{Binding MarkSpins}" Text="{Binding MarkGlyph}"
                                             ToolTip.Tip="{Binding MarkTitle}" IsVisible="{Binding HasMark}" Margin="0,0,6,0" />
                                  <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <DockPanel LastChildFill="True" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="views:DetailViewModel">
                                        <DockPanel>
                                          <TextBlock DockPanel.Dock="Left" Classes="detail-separator" Text="·" IsVisible="{Binding HasSeparator}" />
                                          <TextBlock Classes="detail" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" Text="{Binding Text}" ToolTip.Tip="{Binding Title}" />
                                        </DockPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </DockPanel>
                                </StackPanel>
                                <!-- The negative margins let the 26px buttons reach into the gap above line 2 and the row's padding, so a two-line row keeps its height. -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Classes="actions" Classes.empty="{Binding !HasActions}" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,-3,0,-5">
                                <Button Classes="icon-button" IsVisible="{Binding HasCopy}" ToolTip.Tip="{Binding CopyTitle}" Click="OnCopyClicked">
                                  <TextBlock Classes="icon" Text="&#xEBCC;" />
                                </Button>
                                <Button Classes="icon-button" IsVisible="{Binding HasReport}" ToolTip.Tip="{Binding ReportTitle}" Click="OnReportClicked">
                                  <TextBlock Classes="icon" Text="&#xEA7B;" />
                                </Button>
                                <Button Classes="main" Classes.accent="{Binding MainIsApprove}" IsVisible="{Binding HasMain}" ToolTip.Tip="{Binding MainTitle}" Click="OnMainClicked"
                                        AutomationProperties.Name="{Binding Main}">
                                  <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="icon" Text="{Binding MainGlyph}" />
                                    <TextBlock Text="{Binding Main}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Button>
                                </StackPanel>
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- The end of a search's results (PRD R63): what was not found, and how to search further back. -->
          <StackPanel Name="SearchEnd" IsVisible="{Binding ShowsSearchEnd}" Margin="8,0,8,8" Spacing="4">
            <TextBlock Name="NoMatchLine" Text="{Binding NoMatchText}" IsVisible="{Binding NoMatches}" TextWrapping="Wrap" Classes="muted" />
            <TextBlock Name="SearchNoteLine" Text="{Binding SearchNote}" IsVisible="{Binding SearchNote, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" Classes="muted" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Name="SearchFurtherButton" Classes="link" Content="Search further back" IsVisible="{Binding CanSearchFurther}" Click="OnSearchFurtherClicked" />
              <Button Name="SearchAllTimeButton" Classes="link" Content="All time" IsVisible="{Binding OffersAllTime}" Click="OnSearchAllTimeClicked" />
              <!-- A search that matched nothing offers a way back to the whole list. -->
              <Button Name="NoMatchesClear" Classes="link" Content="Clear search" IsVisible="{Binding NoMatches}" Click="OnClearSearchClicked" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Canvas Name="DropLayer" IsHitTestVisible="False">
          <Border Name="DropLine" IsVisible="False" />
        </Canvas>
        </Panel>
      </ScrollViewer>
    </DockPanel>
    <!-- The inner edge of a dock on the left: dragging it sets the dock's width. -->
    <Border Name="Grip" Grid.Column="2" Width="5" Background="Transparent" Cursor="SizeWestEast" BorderBrush="{DynamicResource DockBorder}" BorderThickness="1,0,0,0"
            IsVisible="{Binding GripOnRight}" PointerPressed="OnGripPressed" PointerMoved="OnGripMoved" PointerReleased="OnGripReleased" PointerCaptureLost="OnGripCaptureLost" />
    <!-- Covers either outer edge with the row stripes while the dock is auto-hidden. -->
    <views:SliverView Name="Sliver" Grid.ColumnSpan="3" Width="{x:Static platform:DockPlacement.SliverWidth}" HorizontalAlignment="Left" IsVisible="False" IsHitTestVisible="False" Background="{DynamicResource DockBackground}" />
  </Grid>
</Window>
