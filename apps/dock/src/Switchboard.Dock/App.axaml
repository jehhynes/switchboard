<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Switchboard.Dock.App"
             RequestedThemeVariant="Default">
  <!-- Colours are VS Code's Light Modern and Dark Modern theme values, also set on the Fluent theme's control keys; the dock follows Windows' light or dark mode. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DockBackground" Color="#F8F8F8" />
          <SolidColorBrush x:Key="DockForeground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="DockMuted" Color="#717171" />
          <SolidColorBrush x:Key="DockHover" Color="#F0F0F0" />
          <SolidColorBrush x:Key="DockSelected" Color="#E4E6F1" />
          <SolidColorBrush x:Key="DockBorder" Color="#E5E5E5" />
          <SolidColorBrush x:Key="DockWarning" Color="#BF8803" />
          <SolidColorBrush x:Key="DockError" Color="#E51400" />
          <SolidColorBrush x:Key="DockPriority" Color="#E8820C" />
          <SolidColorBrush x:Key="DockKeyGithub" Color="#1F2328" />
          <SolidColorBrush x:Key="DockKeyGithubFill" Color="#2E1F2328" />
          <SolidColorBrush x:Key="DockKeyGithubHover" Color="#521F2328" />
          <SolidColorBrush x:Key="DockPullRequest" Color="#8250DF" />
          <SolidColorBrush x:Key="DockPullRequestFill" Color="#2E8250DF" />
          <SolidColorBrush x:Key="DockPullRequestHover" Color="#528250DF" />
          <SolidColorBrush x:Key="DockPillFill" Color="#1F3B3B3B" />
          <SolidColorBrush x:Key="DockPillFillHover" Color="#333B3B3B" />
          <SolidColorBrush x:Key="DockWarningFill" Color="#2EBF8803" />
          <SolidColorBrush x:Key="DockBadge" Color="#CCCCCC" />
          <SolidColorBrush x:Key="DockLink" Color="#005FB8" />
          <SolidColorBrush x:Key="DockFocus" Color="#005FB8" />
          <!-- Row stripes for whose turn it is: the focus blue for the operator's, a grey for the agent's (PRD R27). -->
          <SolidColorBrush x:Key="DockTurn" Color="#005FB8" />
          <SolidColorBrush x:Key="DockAgent" Color="#B4B4B4" />
          <SolidColorBrush x:Key="DockActionButton" Color="#1F3B3B3B" />
          <SolidColorBrush x:Key="DockActionButtonHover" Color="#333B3B3B" />
          <SolidColorBrush x:Key="DockGroupBar" Color="#40005FB8" />
          <SolidColorBrush x:Key="DockGroupBarHover" Color="#59005FB8" />
          <SolidColorBrush x:Key="DockBandBar" Color="#1F005FB8" />
          <SolidColorBrush x:Key="DockBandBarHover" Color="#38005FB8" />
          <SolidColorBrush x:Key="DockCountBadge" Color="#005FB8" />
          <SolidColorBrush x:Key="DockCountBadgeForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DockBadgeZero" Color="#2E717171" />
          <SolidColorBrush x:Key="DockSourceGithub" Color="#1F2328" />
          <SolidColorBrush x:Key="DockSourceOff" Color="#8A8A8A" />
          <SolidColorBrush x:Key="DockBadgeForeground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#CECECE" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#CECECE" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#005FB8" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#767676" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#767676" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#767676" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CECECE" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#CECECE" />
          <SolidColorBrush x:Key="ButtonBackground" Color="#E5E5E5" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#CCCCCC" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CCCCCC" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#3B3B3B" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#3B3B3B" />
          <SolidColorBrush x:Key="AccentButtonBackground" Color="#005FB8" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0258A8" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0258A8" />
          <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DockBackground" Color="#181818" />
          <SolidColorBrush x:Key="DockForeground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="DockMuted" Color="#9D9D9D" />
          <SolidColorBrush x:Key="DockHover" Color="#2A2D2E" />
          <SolidColorBrush x:Key="DockSelected" Color="#04395E" />
          <SolidColorBrush x:Key="DockBorder" Color="#2B2B2B" />
          <SolidColorBrush x:Key="DockWarning" Color="#CCA700" />
          <SolidColorBrush x:Key="DockError" Color="#F14C4C" />
          <SolidColorBrush x:Key="DockPriority" Color="#E8820C" />
          <SolidColorBrush x:Key="DockKeyGithub" Color="#F0F6FC" />
          <SolidColorBrush x:Key="DockKeyGithubFill" Color="#2EF0F6FC" />
          <SolidColorBrush x:Key="DockKeyGithubHover" Color="#52F0F6FC" />
          <SolidColorBrush x:Key="DockPullRequest" Color="#A371F7" />
          <SolidColorBrush x:Key="DockPullRequestFill" Color="#2EA371F7" />
          <SolidColorBrush x:Key="DockPullRequestHover" Color="#52A371F7" />
          <SolidColorBrush x:Key="DockPillFill" Color="#1FCCCCCC" />
          <SolidColorBrush x:Key="DockPillFillHover" Color="#33CCCCCC" />
          <SolidColorBrush x:Key="DockWarningFill" Color="#2ECCA700" />
          <SolidColorBrush x:Key="DockBadge" Color="#616161" />
          <SolidColorBrush x:Key="DockLink" Color="#4DAAFC" />
          <SolidColorBrush x:Key="DockFocus" Color="#0078D4" />
          <SolidColorBrush x:Key="DockTurn" Color="#0078D4" />
          <SolidColorBrush x:Key="DockAgent" Color="#5A5A5A" />
          <SolidColorBrush x:Key="DockActionButton" Color="#1FCCCCCC" />
          <SolidColorBrush x:Key="DockActionButtonHover" Color="#33CCCCCC" />
          <SolidColorBrush x:Key="DockGroupBar" Color="#400078D4" />
          <SolidColorBrush x:Key="DockGroupBarHover" Color="#590078D4" />
          <SolidColorBrush x:Key="DockBandBar" Color="#1F0078D4" />
          <SolidColorBrush x:Key="DockBandBarHover" Color="#380078D4" />
          <SolidColorBrush x:Key="DockCountBadge" Color="#0078D4" />
          <SolidColorBrush x:Key="DockCountBadgeForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DockBadgeZero" Color="#2E9D9D9D" />
          <SolidColorBrush x:Key="DockSourceGithub" Color="#F0F6FC" />
          <SolidColorBrush x:Key="DockSourceOff" Color="#7A7A7A" />
          <SolidColorBrush x:Key="DockBadgeForeground" Color="#F8F8F8" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#313131" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#313131" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#313131" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3C3C3C" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3C3C3C" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0078D4" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#989898" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#989898" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#989898" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#313131" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#313131" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3C3C3C" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3C3C3C" />
          <SolidColorBrush x:Key="ButtonBackground" Color="#313131" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3C3C3C" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3C3C3C" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#CCCCCC" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#CCCCCC" />
          <SolidColorBrush x:Key="AccentButtonBackground" Color="#0078D4" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#026EC1" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#026EC1" />
          <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="DockKeyZoho" Color="#089949" />
      <SolidColorBrush x:Key="DockKeyZohoFill" Color="#2E089949" />
      <SolidColorBrush x:Key="DockKeyZohoHover" Color="#52089949" />
      <SolidColorBrush x:Key="DockKeyForum" Color="#57AE57" />
      <SolidColorBrush x:Key="DockKeyForumFill" Color="#2E57AE57" />
      <SolidColorBrush x:Key="DockKeyForumHover" Color="#5257AE57" />
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
      <!-- Source logos, from the VS Code panel's source icons. -->
      <StreamGeometry x:Key="SourceGithub">M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12</StreamGeometry>
      <StreamGeometry x:Key="SourceZoho">M12 36 L15 18 Q15.3 16 17.5 16 L29.5 16 Q31 16 31.2 14.5 L31.6 11.6 Q31.7 10.4 30.5 10.1 Q29 9.7 29 8.4 L29 5 Q29 3 31 3 L35.5 3 Q37.5 3 37.5 5 L37.5 17.5 L25 24.5 L20 20.5 M35.6 24 L34.6 30.5 Q34.3 32 32.6 32 L17.5 32L12 36</StreamGeometry>
      <StreamGeometry x:Key="SourceForum">F0 M75 20H260V145H160L100 180V145H75Z M95 40V125H120V145L150 125H240V40Z</StreamGeometry>
      <FontFamily x:Key="Codicons">avares://Switchboard.Dock/Assets/codicon.ttf#codicon</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- VS Code's controls: square corners, compact height, and a one-pixel focus border. -->
    <Style Selector="TextBox, ComboBox, AutoCompleteBox, Button">
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter, Button.link:pointerover /template/ ContentPresenter, Button.link:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DockLink}" />
    </Style>
  </Application.Styles>
</Application>
