<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A console program, so the hub talks to it over stdin and stdout; the hub starts it without a window. -->
    <OutputType>Exe</OutputType>
    <AssemblyName>Switchboard.PaneHelper</AssemblyName>
    <RootNamespace>Switchboard.PaneHelper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Switchboard.PaneHelper.Tests" />
  </ItemGroup>
</Project>
