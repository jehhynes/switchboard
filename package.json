{
  "name": "switchboard-root",
  "private": true,
  "version": "0.0.0",
  "description": "Local software factory: triages assigned tickets into playbooks and runs them in Claude Code sessions.",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/core",
    "packages/github",
    "packages/zoho",
    "packages/forum",
    "packages/holder",
    "packages/claude",
    "packages/codex",
    "packages/hub",
    "apps/hub",
    "apps/dock",
    "extensions/switchboard",
    "extensions/chrome",
    "extensions/firefox",
    "extensions/gnome-shell"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "watch": "node tools/watch.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "verify": "npm run build && npm run typecheck && npm test",
    "test:integration": "npm run build && npm run test:integration --workspace switchboard",
    "verify:full": "npm run verify && npm run test:integration",
    "prepare": "node -e \"try { require('node:child_process').execSync('git config core.hooksPath .githooks', { stdio: 'ignore' }) } catch {}\""
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
