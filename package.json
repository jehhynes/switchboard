{
  "name": "switchboard-root",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Local software factory: triages assigned tickets into playbooks and runs them in Claude Code sessions.",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/core",
    "packages/github",
    "packages/zoho",
    "packages/holder",
    "packages/conversation",
    "packages/protocol",
    "packages/voice",
    "packages/claude",
    "packages/codex",
    "packages/web",
    "packages/hub",
    "extensions/chrome",
    "extensions/firefox",
    "apps/hub"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "watch": "node tools/watch.mjs",
    "install-local": "npm run build && node apps/hub/dist/install/hub.js install --wait",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "verify": "node tools/verify.mjs",
    "verify:staged": "node tools/precommit.mjs",
    "prepare": "node -e \"try { require('node:child_process').execSync('git config core.hooksPath .githooks', { stdio: 'ignore' }) } catch {}\""
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
